# Copy this file to .env (same folder) and fill in your own key. Never commit .env.
# The agents call gpt-6-luna through Portkey (https://api.portkey.ai/v1).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: token prices (USD per 1M tokens) used for the dashboard's $ spend limit.
# LUNA_PRICE_INPUT_PER_M=0.10
# LUNA_PRICE_OUTPUT_PER_M=0.50
